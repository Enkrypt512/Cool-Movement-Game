[node name="Credits" type="Label" parent="Credits" unique_id=172232235]
layout_mode = 0
offset_top = 81.0
offset_right = 612.0
offset_bottom = 225.0
theme_override_font_sizes/font_size = 32
text = "rem: For Playtesting
Kenney: For Most Of The Assets
Lukky: For The Base Movement Code
Datagoblin: For The Monogram Font
Greg Zaal And Jarod Guest: For The Sky Texture 
Pichuliru: For The Smoke Grenade Model 
JoyTree Studios:  For The Grenade Texture 
musdasch: For The Bullet Decal Texture
plaggy: For The Knife Model And The Arrow Model
LiamOsler: For The Bow Model
Dragon Studio: For The Slamming SFX
rubberduck: For The Changing Gun SFX
kyles: For The Shooting SFX
thatguynm: For Most Of The Music
qubodup: For The Explosion SFX
SeKa: For The Dying Music
teeeece: For The Flashbang SFX
And You! For Playing <3"

